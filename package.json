{
  "name": "tennis-live-edge",
  "private": true,
  "scripts": {
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "api:dev": "cd services/api && ../../.venv/bin/uvicorn tennis_edge.main:app --host 127.0.0.1 --port 8000 --reload",
    "api:ingest": "cd services/api && ../../.venv/bin/python -m tennis_edge.ingest_once",
    "api:test": "cd services/api && ../../.venv/bin/pytest",
    "web:test": "npm --prefix apps/web test",
    "cloudflare:check": "python3 scripts/check_cloudflare_private_runtime.py",
    "cloudflare:check:example": "PRIVATE_ALLOWED_EMAILS=operator@example.com ADMIN_API_TOKEN=local-admin TENNIS_EDGE_CORS_ORIGIN=http://localhost:3000,https://edge.example.com python3 scripts/check_cloudflare_private_runtime.py --example",
    "openclaw:briefing": "node openclaw/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs briefing",
    "openclaw:anomalies": "node openclaw/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs anomalies",
    "openclaw:runs": "node openclaw/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs runs",
    "openclaw:preflight": "node openclaw/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs preflight",
    "openclaw:autopilot": "zsh -lc 'set -a; source .env; set +a; printf \"%s\" \"$ADMIN_API_TOKEN\" | node openclaw/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs autopilot --token-stdin'",
    "openclaw:test": "node --test openclaw/skills/tennis-edge-ops/scripts/*.test.mjs",
    "dev": "concurrently \"npm run api:dev\" \"npm run web:dev\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

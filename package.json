{
  "name": "tennis-live-edge",
  "private": true,
  "scripts": {
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "api:dev": "cd services/api && ../../.venv/bin/uvicorn tennis_edge.main:app --host 127.0.0.1 --port 8000 --reload",
    "api:ingest": "cd services/api && ../../.venv/bin/python -m tennis_edge.ingest_once",
    "api:ingest:api-tennis": "cd services/api && ../../.venv/bin/python -m tennis_edge.ingest_api_tennis_scores",
    "api:ingest:archive-odds": "cd services/api && ../../.venv/bin/python -m tennis_edge.ingest_archive_odds",
    "api:ingest:live-budget": "cd services/api && ../../.venv/bin/python -m tennis_edge.ingest_live_budget",
    "api:ingest:odds-message": "cd services/api && ../../.venv/bin/python -m tennis_edge.ingest_odds_message",
    "api:ingest:odds-stream": "cd services/api && ../../.venv/bin/python -m tennis_edge.ingest_odds_stream",
    "api:ops:daily": "cd services/api && ../../.venv/bin/python -m tennis_edge.operational_daily",
    "api:replay:contracts": "cd services/api && ../../.venv/bin/python -m tennis_edge.replay_contracts",
    "api:check:operational-truth": "python3 scripts/check_operational_truth_runtime.py",
    "api:test": "cd services/api && ../../.venv/bin/pytest",
    "web:test": "npm --prefix apps/web test",
    "cloudflare:check": "python3 scripts/check_cloudflare_private_runtime.py",
    "cloudflare:check:example": "PRIVATE_ALLOWED_EMAILS=operator@example.com ADMIN_API_TOKEN=local-admin TENNIS_EDGE_CORS_ORIGIN=http://localhost:3000,https://edge.example.com python3 scripts/check_cloudflare_private_runtime.py --example",
    "hermes:briefing": "node hermes/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs briefing",
    "hermes:anomalies": "node hermes/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs anomalies",
    "hermes:runs": "node hermes/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs runs",
    "hermes:preflight": "node hermes/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs preflight",
    "hermes:intelligence": "node hermes/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs intelligence",
    "hermes:events": "node hermes/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs events",
    "hermes:playbook": "node hermes/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs playbook",
    "hermes:live-stats": "node hermes/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs live-stats",
    "hermes:ops:daily": "zsh -lc 'set -a; source .env; set +a; printf \"%s\" \"$ADMIN_API_TOKEN\" | node hermes/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs ops-daily --token-stdin'",
    "hermes:autopilot": "zsh -lc 'set -a; source .env; set +a; printf \"%s\" \"$ADMIN_API_TOKEN\" | node hermes/skills/tennis-edge-ops/scripts/tennis_edge_ops.mjs autopilot --token-stdin'",
    "hermes:test": "node --test hermes/skills/tennis-edge-ops/scripts/*.test.mjs",
    "dev": "concurrently \"npm run api:dev\" \"npm run web:dev\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
